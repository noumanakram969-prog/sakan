# Meta Marketing API + Conversions API
#
# Fill these in, save this file as  .env.ads  (same folder), and tell me it is ready.
# .env.ads is gitignored - it never gets committed, and I will not print the values.
#
# Everything built against this creates campaigns PAUSED, with the minimum budget,
# and never activates them. No spend.

# --- Marketing API ---------------------------------------------------------
# Ads Manager -> account picker (top left). Include the "act_" prefix.
META_AD_ACCOUNT_ID=act_

# developers.facebook.com -> Graph API Explorer -> app "Mistri" (1317358583652870)
# Permissions to tick: ads_management, ads_read, business_management
META_ADS_ACCESS_TOKEN=

# Optional - only if the ad account sits under a specific business portfolio
META_BUSINESS_ID=

# --- Conversions API -------------------------------------------------------
# Events Manager -> your dataset -> the ID shown at the top
META_PIXEL_ID=

# Events Manager -> dataset -> Settings -> Generate access token
META_CAPI_TOKEN=

# Events Manager -> dataset -> Test events -> the code shown (e.g. TEST12345)
# With this set, events land in Test Events only and never touch real reporting.
META_CAPI_TEST_EVENT_CODE=

# --- Graph API version -----------------------------------------------------
META_GRAPH_VERSION=v21.0
