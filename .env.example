# --- WhatsApp ---
# meta  = Meta Cloud API direct (use this with the free test number)
# d360  = 360dialog (use this for Care's real coexistence number)
WA_PROVIDER=meta

# Meta Cloud API
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me
META_GRAPH_VERSION=v21.0

# 360dialog
D360_API_KEY=
# Required with WA_PROVIDER=d360. Invent a long random string and put it on the
# callback URL: https://bot.example.ae/webhook?token=THIS
WEBHOOK_TOKEN=

# --- Anthropic ---
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
DATABASE_URL=sqlite:///./mistri.db
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
TIMEZONE=Asia/Dubai

# Shown on /privacy, which Meta requires before it will review the app.
OPERATOR_NAME=
OPERATOR_EMAIL=
HANDOFF_PAUSE_HOURS=2
HANDOFF_AUTO_RELEASE_HOURS=24
ENABLE_SCHEDULER=true
MAX_REPLIES_PER_DAY=40
